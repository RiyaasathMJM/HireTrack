# HireTrack — Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=true

# ── MySQL Database ────────────────────────────────────────────────────────────
# For local development: use your local MySQL server credentials
# For production (PlanetScale / Railway): paste the connection values here

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=hiretrack

# ── AI (optional) ─────────────────────────────────────────────────────────────
# If set, the /api/candidates/:id/summarize endpoint uses GPT-3.5-turbo.
# If not set, a local heuristic summary is used instead (no cost, no internet).
OPENAI_API_KEY=
