# HireTrack — Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ── PostgreSQL / Supabase Database ────────────────────────────────────────────
# Option A: Use a full connection URL (Railway sets this automatically)
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Option B: Individual params (used when DATABASE_URL is not set)
PG_HOST=db.mvsmtegmeovlkkohzzrn.supabase.co
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=postgres
PG_SSLMODE=require

# ── AI (optional) ─────────────────────────────────────────────────────────────
# If set, the /api/candidates/:id/summarize endpoint uses GPT-3.5-turbo.
# If not set, a local heuristic summary is used instead (no cost, no internet).
OPENAI_API_KEY=
